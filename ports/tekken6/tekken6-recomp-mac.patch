--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,8 +7,14 @@
 if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
     set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
 endif()
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$" OR CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
+    set(TEKKEN6_HOST_X86 OFF)
+else()
+    set(TEKKEN6_HOST_X86 ON)
+endif()
+# ARM64 always has fused multiply-add; the flag only applies to x86 hosts.
 option(TEKKEN6_ENABLE_FMA3
-    "Compile generated guest code for CPUs with FMA3" ON)
+    "Compile generated guest code for CPUs with FMA3" ${TEKKEN6_HOST_X86})
 
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
@@ -23,6 +29,9 @@
     "Build existing guest sources without invoking target-platform codegen" OFF)
 set(REXGLUE_USE_PREGENERATED_CODE ${TEKKEN6_USE_PREGENERATED_CODE})
 include(generated/rexglue.cmake)
+# The SDK sets REXGLUE_ROOT only in its own directory scope, but its macOS
+# Vulkan staging helper runs from this one and reads the MoltenVK ICD from it.
+set(REXGLUE_ROOT "${REXSDK_DIR}")
 
 # Small ISO inspection/extraction utility; game data remains local to the user.
 add_subdirectory(tools/xdvdfs)
@@ -54,7 +63,9 @@
 endif()
 
 add_executable(tekken6 src/main.cpp src/tekken6_guest_hooks.cpp src/internal_resolution.cpp)
-target_compile_options(tekken6 PRIVATE -mssse3)
+if(TEKKEN6_HOST_X86)
+    target_compile_options(tekken6 PRIVATE -mssse3)
+endif()
 if(WIN32)
     target_sources(tekken6 PRIVATE src/tekken6_crash_win.cpp)
     target_link_libraries(tekken6 PRIVATE dbghelp)
