+// Draws the window title in a game-supplied font (macOS only).
+//
+// REX_WINDOW_TITLE_FONT=/path/to/font.ttf  registers that font for this process
+// REX_WINDOW_TITLE_FONT_SIZE=18            point size (default 17)
+// The native title is hidden (it stays set, so Mission Control and the Dock still
+// show it) and a centered label in the title bar shows the same text instead.
+
+#import <AppKit/AppKit.h>
+#import <CoreText/CoreText.h>
+
+#include <cstdlib>
+#include <string>
+
+namespace rex::ui {
+
+static NSFont* TitleFont() {
+  static NSFont* font = nil;
+  static bool tried = false;
+  if (tried) {
+    return font;
+  }
+  tried = true;
+  const char* path = std::getenv("REX_WINDOW_TITLE_FONT");
+  if (!path || !*path) {
+    return nil;
+  }
+  NSURL* url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path]];
+  CFArrayRef descriptors = CTFontManagerCreateFontDescriptorsFromURL((__bridge CFURLRef)url);
+  if (!descriptors || CFArrayGetCount(descriptors) == 0) {
+    if (descriptors) CFRelease(descriptors);
+    return nil;
+  }
+  CTFontManagerRegisterFontsForURL((__bridge CFURLRef)url, kCTFontManagerScopeProcess, nullptr);
+  const char* size_env = std::getenv("REX_WINDOW_TITLE_FONT_SIZE");
+  CGFloat size = size_env ? std::atof(size_env) : 17.0;
+  auto desc = (CTFontDescriptorRef)CFArrayGetValueAtIndex(descriptors, 0);
+  CTFontRef ct = CTFontCreateWithFontDescriptor(desc, size > 0 ? size : 17.0, nullptr);
+  CFRelease(descriptors);
+  font = (__bridge_transfer NSFont*)ct;
+  return font;
+}
+
+void ApplyStyledTitleMac(void* ns_window, const std::string& title) {
+  NSFont* font = TitleFont();
+  if (!font || !ns_window) {
+    return;
+  }
+  NSString* text = [NSString stringWithUTF8String:title.c_str()];
+  dispatch_block_t apply = ^{
+    NSWindow* window = (__bridge NSWindow*)ns_window;
+    NSView* bar = [window standardWindowButton:NSWindowCloseButton].superview;
+    if (!bar) {
+      return;
+    }
+    window.titleVisibility = NSWindowTitleHidden;
+    NSTextField* label = nil;
+    for (NSView* v in bar.subviews) {
+      if ([v.identifier isEqualToString:@"rex.styled-title"]) label = (NSTextField*)v;
+    }
+    if (!label) {
+      label = [NSTextField labelWithString:@""];
+      label.identifier = @"rex.styled-title";
+      label.font = font;
+      label.alignment = NSTextAlignmentCenter;
+      label.lineBreakMode = NSLineBreakByTruncatingTail;
+      label.translatesAutoresizingMaskIntoConstraints = NO;
+      [bar addSubview:label];
+      [NSLayoutConstraint activateConstraints:@[
+        [label.centerXAnchor constraintEqualToAnchor:bar.centerXAnchor],
+        [label.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor],
+        [label.widthAnchor constraintLessThanOrEqualToAnchor:bar.widthAnchor constant:-160],
+      ]];
+    }
+    label.stringValue = text;
+  };
+  if ([NSThread isMainThread]) apply(); else dispatch_async(dispatch_get_main_queue(), apply);
+}
+
+}  // namespace rex::ui
