+  SDL_Joystick* joystick = id ? SDL_OpenJoystick(id) : nullptr;
+  if (!joystick) {
+    REXLOG_ERROR("SDL virtual pad test: attach failed: {}", SDL_GetError());
+    return;
+  }
+  REXLOG_INFO("SDL virtual pad test: attached joystick {}", static_cast<uint32_t>(id));
+  // TEKKEN6_VIRTUAL_PAD_SCRIPT="15000:start 3000:down 1500:a ..." taps each
+  // button after the given delay in milliseconds, then stops.
+  // "delay:button:hold_ms" holds a button; "delay:axis:value:hold_ms" holds a stick
+  // or trigger (SDL names: leftx, lefty, rightx, righty, lefttrigger, righttrigger;
+  // value -32768..32767, negative lefty = up) and then recenters it.
+  struct Step {
+    uint32_t delay_ms;
+    int button;  // -1 for an axis step
+    int axis;
+    int16_t value;
+    uint32_t hold_ms;
+  };
+  auto parse = [](const std::string& text) {
+    std::vector<Step> steps;
+    std::istringstream stream(text);
+    std::string token;
+    while (stream >> token) {
+      std::vector<std::string> parts;
+      size_t start = 0;
+      for (size_t colon; (colon = token.find(':', start)) != std::string::npos; start = colon + 1) {
+        parts.push_back(token.substr(start, colon - start));
+      }
+      parts.push_back(token.substr(start));
+      if (parts.size() < 2) {
+        continue;
+      }
+      uint32_t delay_ms = uint32_t(std::strtoul(parts[0].c_str(), nullptr, 10));
+      int axis = SDL_GetGamepadAxisFromString(parts[1].c_str());
+      if (axis != SDL_GAMEPAD_AXIS_INVALID && parts.size() >= 4) {
+        steps.push_back({delay_ms, -1, axis, int16_t(std::strtol(parts[2].c_str(), nullptr, 10)),
+                         uint32_t(std::strtoul(parts[3].c_str(), nullptr, 10))});
+        continue;
+      }
+      int button = SDL_GetGamepadButtonFromString(parts[1].c_str());
+      if (button == SDL_GAMEPAD_BUTTON_INVALID) {
+        REXLOG_ERROR("SDL virtual pad test: unknown button '{}'", parts[1]);
+        continue;
+      }
+      uint32_t hold_ms = parts.size() >= 3 ? uint32_t(std::strtoul(parts[2].c_str(), nullptr, 10)) : 150;
+      steps.push_back({delay_ms, button, 0, 0, hold_ms});
+    }
+    return steps;
+  };
+  auto play = [joystick](const std::vector<Step>& steps) {
+    for (const auto& step : steps) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(step.delay_ms));
+      if (step.button < 0) {
+        SDL_SetJoystickVirtualAxis(joystick, step.axis, step.value);
+        std::this_thread::sleep_for(std::chrono::milliseconds(step.hold_ms));
+        SDL_SetJoystickVirtualAxis(joystick, step.axis, 0);
+      } else {
+        SDL_SetJoystickVirtualButton(joystick, step.button, true);
+        std::this_thread::sleep_for(std::chrono::milliseconds(step.hold_ms));
+        SDL_SetJoystickVirtualButton(joystick, step.button, false);
+      }
+    }
+  };
+  // TEKKEN6_VIRTUAL_PAD_SCRIPT="15000:start 3000:down 1500:a ..." taps each
+  // button after the given delay in milliseconds, then stops.
+  // "delay:button:hold_ms" holds a button; "delay:axis:value:hold_ms" holds a stick
+  // or trigger (SDL names: leftx, lefty, rightx, righty, lefttrigger, righttrigger;
+  // value -32768..32767, negative lefty = up) and then recenters it.
+  // TEKKEN6_VIRTUAL_PAD_FIFO=/path/to/fifo plays each line written to that named
+  // pipe in the same format, for steering the game live.
+  const char* script = std::getenv("TEKKEN6_VIRTUAL_PAD_SCRIPT");
+  const char* fifo = std::getenv("TEKKEN6_VIRTUAL_PAD_FIFO");
+  if (script || fifo) {
+    std::thread([script = std::string(script ? script : ""), fifo = std::string(fifo ? fifo : ""),
+                 parse, play]() {
+      play(parse(script));
+      while (!fifo.empty()) {
+        std::ifstream in(fifo);  // blocks until a writer opens the pipe
+        for (std::string line; std::getline(in, line);) {
+          play(parse(line));
+        }
+      }
+    }).detach();
+    return;
+  }
+  std::thread([joystick]() {
+    std::this_thread::sleep_for(std::chrono::seconds(15));
+    for (uint32_t i = 0;; ++i) {
+      int button = (i & 1) ? SDL_GAMEPAD_BUTTON_SOUTH : SDL_GAMEPAD_BUTTON_START;
+      SDL_SetJoystickVirtualButton(joystick, button, true);
+      std::this_thread::sleep_for(std::chrono::milliseconds(150));
+      SDL_SetJoystickVirtualButton(joystick, button, false);
+      std::this_thread::sleep_for(std::chrono::milliseconds(2350));
+    }
+  }).detach();
+}
