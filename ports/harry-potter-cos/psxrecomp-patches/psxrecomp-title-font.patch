diff --git a/runtime/src/psx_title_font_mac.mm b/runtime/src/psx_title_font_mac.mm
new file mode 100644
index 00000000..24ac248e
--- /dev/null
+++ b/runtime/src/psx_title_font_mac.mm
@@ -0,0 +1,114 @@
+// Draws the window title in a game-supplied font (macOS only).
+//
+// PSX_WINDOW_TITLE_FONT=/path/to/font.ttf  registers that font for this process
+// PSX_WINDOW_TITLE_FONT_SIZE=18            point size (default 17)
+// The native title is hidden (it stays set, so Mission Control and the Dock still
+// show it) and a centered label in the title bar shows the same text instead.
+// The label follows later SDL_SetWindowTitle calls by observing NSWindow.title.
+// No effect when PSX_WINDOW_TITLE_FONT is unset or the font cannot be loaded.
+
+#import <AppKit/AppKit.h>
+#import <CoreText/CoreText.h>
+
+#include <SDL3/SDL.h>
+
+#include <cstdlib>
+
+static NSString* const kPsxTitleLabelId = @"psx.styled-title";
+
+static NSFont* PsxTitleFont() {
+  static NSFont* font = nil;
+  static bool tried = false;
+  if (tried) {
+    return font;
+  }
+  tried = true;
+  const char* path = std::getenv("PSX_WINDOW_TITLE_FONT");
+  if (!path || !*path) {
+    return nil;
+  }
+  NSURL* url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path]];
+  CFArrayRef descriptors = CTFontManagerCreateFontDescriptorsFromURL((__bridge CFURLRef)url);
+  if (!descriptors || CFArrayGetCount(descriptors) == 0) {
+    if (descriptors) CFRelease(descriptors);
+    return nil;
+  }
+  CTFontManagerRegisterFontsForURL((__bridge CFURLRef)url, kCTFontManagerScopeProcess, nullptr);
+  const char* size_env = std::getenv("PSX_WINDOW_TITLE_FONT_SIZE");
+  CGFloat size = size_env ? std::atof(size_env) : 17.0;
+  auto desc = (CTFontDescriptorRef)CFArrayGetValueAtIndex(descriptors, 0);
+  CTFontRef ct = CTFontCreateWithFontDescriptor(desc, size > 0 ? size : 17.0, nullptr);
+  CFRelease(descriptors);
+  font = (__bridge_transfer NSFont*)ct;
+  return font;
+}
+
+static void PsxTitleSync(NSWindow* window) {
+  NSView* bar = [window standardWindowButton:NSWindowCloseButton].superview;
+  if (!bar) {
+    return;
+  }
+  window.titleVisibility = NSWindowTitleHidden;
+  NSTextField* label = nil;
+  for (NSView* v in bar.subviews) {
+    if ([v.identifier isEqualToString:kPsxTitleLabelId]) label = (NSTextField*)v;
+  }
+  if (!label) {
+    label = [NSTextField labelWithString:@""];
+    label.identifier = kPsxTitleLabelId;
+    label.font = PsxTitleFont();
+    label.alignment = NSTextAlignmentCenter;
+    label.lineBreakMode = NSLineBreakByTruncatingTail;
+    label.translatesAutoresizingMaskIntoConstraints = NO;
+    [bar addSubview:label];
+    [NSLayoutConstraint activateConstraints:@[
+      [label.centerXAnchor constraintEqualToAnchor:bar.centerXAnchor],
+      [label.centerYAnchor constraintEqualToAnchor:bar.centerYAnchor],
+      [label.widthAnchor constraintLessThanOrEqualToAnchor:bar.widthAnchor constant:-160],
+    ]];
+  }
+  label.stringValue = window.title ?: @"";
+}
+
+@interface PsxTitleObserver : NSObject
+@end
+
+@implementation PsxTitleObserver
+- (void)observeValueForKeyPath:(NSString*)keyPath
+                      ofObject:(id)object
+                        change:(NSDictionary*)change
+                       context:(void*)context {
+  NSWindow* window = (NSWindow*)object;
+  if ([NSThread isMainThread]) {
+    PsxTitleSync(window);
+  } else {
+    dispatch_async(dispatch_get_main_queue(), ^{ PsxTitleSync(window); });
+  }
+}
+@end
+
+extern "C" void psx_title_font_apply(SDL_Window* sdl_window) {
+  if (!sdl_window || !PsxTitleFont()) {
+    return;
+  }
+  void* ptr = SDL_GetPointerProperty(SDL_GetWindowProperties(sdl_window),
+                                     SDL_PROP_WINDOW_COCOA_WINDOW_POINTER, nullptr);
+  if (!ptr) {
+    return;
+  }
+  NSWindow* window = (__bridge NSWindow*)ptr;
+  dispatch_block_t apply = ^{
+    static PsxTitleObserver* observer = nil;
+    static NSHashTable<NSWindow*>* observed = nil;
+    if (!observer) {
+      observer = [PsxTitleObserver new];
+      observed = [NSHashTable weakObjectsHashTable];
+    }
+    if (![observed containsObject:window]) {
+      [observed addObject:window];
+      [window addObserver:observer forKeyPath:@"title" options:0 context:nullptr];
+    }
+    PsxTitleSync(window);
+  };
+  if ([NSThread isMainThread]) apply(); else dispatch_async(dispatch_get_main_queue(), apply);
+}
